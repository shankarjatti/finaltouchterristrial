options:
  parameters:
    author: "AVGARDE SYSTEMS — SecureCOM M1"
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Module 2 — High Performance 42-Channel Decoder"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: securecom_module2_decoder
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "SecureCOM Module 2 — Real-Time Decoder"
    window_size: (800,400)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:

- name: samp_rate
  id: variable
  parameters:
    comment: "TCP IQ from Module 1: 200 kSps"
    value: '200000'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [8,100], rotation: 0, state: enabled}

- name: squelch_thresh
  id: variable
  parameters:
    value: '-50'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [280,12], rotation: 0, state: enabled}

- name: gain_demod
  id: variable
  parameters:
    value: '0.2'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [500,12], rotation: 0, state: enabled}

- name: volume
  id: variable
  parameters:
    value: '3.0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [720,12], rotation: 0, state: enabled}

- name: network_tcp_source_dmr
  id: network_tcp_source
  parameters:
    affinity: ''
    alias: ''
    comment: "TCP 127.0.0.1:7001 — DMR446 446.09375MHz"
    addr: 127.0.0.1
    port: '7001'
    server: 'False'
    type: complex
    vlen: '1'
    maxoutbuf: '1024'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [8, 200], rotation: 0, state: enabled}

- name: network_tcp_source_nxdn
  id: network_tcp_source
  parameters:
    affinity: ''
    alias: ''
    comment: "TCP 127.0.0.1:7002 — NXDN96 451.09375MHz"
    addr: 127.0.0.1
    port: '7002'
    server: 'False'
    type: complex
    vlen: '1'
    maxoutbuf: '1024'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [8, 2200], rotation: 0, state: enabled}

- name: network_tcp_source_p25
  id: network_tcp_source
  parameters:
    affinity: ''
    alias: ''
    comment: "TCP 127.0.0.1:7003 — P25 Phase 1 450.09375MHz"
    addr: 127.0.0.1
    port: '7003'
    server: 'False'
    type: complex
    vlen: '1'
    maxoutbuf: '1024'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [8, 4200], rotation: 0, state: enabled}

- name: pfb_channelizer_ccf_0
  id: pfb_channelizer_ccf
  parameters:
    affinity: ''
    alias: ''
    atten: '100'
    bus_structure_source: '[[0,],]'
    ch_map: '[]'
    comment: "DMR446 16ch @ 12.5kSps/ch"
    maxoutbuf: '1024'
    minoutbuf: '0'
    nchans: '16'
    osr: '1.0'
    samp_delay: '0'
    taps: firdes.low_pass(16.0, samp_rate, (samp_rate/16.0)/2.0, 1000)
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [250, 200], rotation: 0, state: enabled}

- name: pfb_channelizer_ccf_0_1
  id: pfb_channelizer_ccf
  parameters:
    affinity: ''
    alias: ''
    atten: '100'
    bus_structure_source: '[[0,],]'
    ch_map: '[]'
    comment: "NXDN96 16ch @ 12.5kSps/ch"
    maxoutbuf: '1024'
    minoutbuf: '0'
    nchans: '16'
    osr: '1.0'
    samp_delay: '0'
    taps: firdes.low_pass(16.0, samp_rate, (samp_rate/16.0)/2.0, 1000)
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [250, 2200], rotation: 0, state: enabled}

- name: pfb_channelizer_ccf_0_0
  id: pfb_channelizer_ccf
  parameters:
    affinity: ''
    alias: ''
    atten: '100'
    bus_structure_source: '[[0,],]'
    ch_map: '[]'
    comment: "P25 Phase 1 10ch @ 20kSps/ch"
    maxoutbuf: '1024'
    minoutbuf: '0'
    nchans: '10'
    osr: '1.0'
    samp_delay: '0'
    taps: firdes.low_pass(10.0, samp_rate, (samp_rate/10.0)/2.0, 1000)
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [250, 4200], rotation: 0, state: enabled}

- name: resamp_iq_dmr_ch0
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: "DMR ch0: PFB port -> 48 kHz IQ"
    decim: '25'
    fbw: '0.4'
    interp: '96'
    maxoutbuf: '1024'
    minoutbuf: '0'
    taps: '[]'
    type: ccf
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [460, 200], rotation: 0, state: enabled}

- name: lpf_dmr_ch0
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: "DMR ch0 Channel LPF"
    cutoff_freq: '6250'
    decim: '1'
    gain: '1.0'
    interp: '1'
    maxoutbuf: '1024'
    minoutbuf: '0'
    samp_rate: '48000'
    type: fir_filter_ccf
    width: '2000'
    win: window.WIN_HAMMING
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [680, 200], rotation: 0, state: enabled}

- name: squelch_dmr_ch0
  id: analog_simple_squelch_cc
  parameters:
    affinity: ''
    alias: ''
    alpha: '0.05'
    comment: "DMR ch0 Zero-Noise Channel Squelch Gate"
    maxoutbuf: '1024'
    minoutbuf: '0'
    threshold: squelch_thresh
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [900, 200], rotation: 0, state: enabled}

- name: demod_dmr_ch0
  id: analog_quadrature_demod_cf
  parameters:
    affinity: ''
    alias: ''
    comment: "DMR ch0 FM Demodulator (gain=0.2)"
    gain: gain_demod
    maxoutbuf: '1024'
    minoutbuf: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1120, 200], rotation: 0, state: enabled}

- name: dsd_dmr_ch0
  id: dsd_block_ff
  parameters:
    affinity: ''
    alias: ''
    comment: "DMR ch0 DSD Voice Decoder"
    errorbars: 'True'
    frame: dsd.dsd_FRAME_DMR_MOTOTRBO
    maxoutbuf: '1024'
    minoutbuf: '0'
    mod: dsd.dsd_MOD_C4FM
    uvquality: '3'
    verbosity: '0'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1340, 200], rotation: 0, state: enabled}

- name: aresamp_dmr_ch0
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: "DMR ch0 DSD Speech 8k -> 48k Audio"
    decim: '1'
    fbw: '0.4'
    interp: '6'
    maxoutbuf: '1024'
    minoutbuf: '0'
    taps: '[]'
    type: fff
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1560, 200], rotation: 0, state: enabled}

- name: vol_dmr_ch0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: "DMR ch0 Volume Boost"
    const: volume
    maxoutbuf: '1024'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [1780, 200], rotation: 0, state: enabled}

- name: resamp_iq_dmr_ch1
  id: rational_resampler_xxx
