options:
  parameters:
    author: "AVGARDE SYSTEMS \u2014 SecureCOM M1"
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Module 2 \u2014 42-Channel Decoder with Combined Spectrum Analyzer"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: securecom_module2_decoder
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "SecureCOM Module 2 \u2014 Multiband Real-Time Receiver"
    window_size: (1200,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 684.0]
    rotation: 0
    state: enabled

blocks:
- name: arity
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1848, 988.0]
    rotation: 0
    state: enabled
- name: channel_rate
  id: variable
  parameters:
    comment: ''
    value: '36000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 932.0]
    rotation: 0
    state: enabled
- name: constel
  id: variable_constellation
  parameters:
    comment: ''
    const_points: '[1-1j, 1+1j, -1-1j, 1-1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: '''auto'''
    sym_map: '[0, 1, 3, 2]'
    type: dqpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3264, 1308.0]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: ''
    value: '5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2360, 1148.0]
    rotation: 0
    state: enabled
- name: freq_offset_khz
  id: variable_qtgui_entry
  parameters:
    comment: ''
    gui_hint: '[1,1]'
    label: Baseband offset [kHz]
    type: real
    value: '-1.714'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2528, 1276.0]
    rotation: 0
    state: enabled
- name: frequency_mhz
  id: variable_qtgui_entry
  parameters:
    comment: ''
    gui_hint: '[1,0]'
    label: Frequency [MHz]
    type: real
    value: '467.5625'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2384, 1172.0]
    rotation: 0
    state: enabled
- name: gain_demod
  id: variable_qtgui_range
  parameters:
    comment: DMR FM demod gain 1.0 -- measured optimum, offline decode test on real captured IQ (3.93 gave silence)
    gui_hint: ''
    label: FM Demod Gain (DMR)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.05'
    step: '0.01'
    stop: '10.0'
    value: '1.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1960, 1124.0]
    rotation: 0
    state: enabled
- name: gain_demod_nxdn
  id: variable_qtgui_range
  parameters:
    comment: NXDN96 gain = 48k/(2pi*1050Hz) = 7.28 (deviation to verify on air)
    gui_hint: ''
    label: FM Demod Gain (NXDN)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.05'
    step: '0.01'
    stop: '14.0'
    value: '7.28'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1960, 1260]
    rotation: 0
    state: enabled
- name: gain_demod_p25
  id: variable_qtgui_range
  parameters:
    comment: P25 C4FM gain = 48k/(2pi*1800Hz) = 4.24
    gui_hint: ''
    label: FM Demod Gain (P25)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.05'
    step: '0.01'
    stop: '10.0'
    value: '4.24'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1960, 1396]
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1256, 892.0]
    rotation: 0
    state: enabled
- name: ppm_corr
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: '[2,0,1,2]'
    label: PPM correction
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '-20'
    step: '1'
    stop: '15'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2288, 1084.0]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(nfilts, nfilts, 1.0/float(sps), 0.35, 11*sps*nfilts)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2112, 948.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'TCP IQ from Module 1: 200 kSps'
    value: '200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 1052.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1776, 1052.0]
    rotation: 0
    state: enabled
- name: squelch_thresh
  id: variable_qtgui_range
  parameters:
    comment: "Channel Squelch Threshold (dB) \u2014 mutes idle channels"
    gui_hint: ''
    label: Noise Squelch Threshold (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-90'
    step: '1'
    stop: '-10'
    value: '-20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1760, 1180.0]
    rotation: 0
    state: enabled
- name: variable_adaptive_algorithm_0
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: constel
    delta: '10.0'
    ffactor: '0.99'
    modulus: '1'
    step_size: 10e-3
    type: cma
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2872, 1300.0]
    rotation: 0
    state: true
- name: volume
  id: variable_qtgui_range
  parameters:
    comment: Audio Speech Output Volume
    gui_hint: ''
    label: Audio Volume Boost
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.01'
    step: '0.01'
    stop: '20.0'
    value: '0.04'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2280, 1196.0]
    rotation: 0
    state: enabled
