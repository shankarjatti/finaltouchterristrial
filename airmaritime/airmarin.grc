connections:
- [adsb_decoder_0, decoded, zeromq_pub_msg_sink_0, in]
- [adsb_demod_0, '0', qtgui_time_sink_x_0, '0']
- [adsb_demod_0, demodulated, adsb_decoder_0, demodulated]
- [adsb_framer_1, '0', adsb_demod_0, '0']
- [ais_invert_0, '0', digital_hdlc_deframer_bp_0, '0']
- [ais_invert_1, '0', digital_hdlc_deframer_bp_1, '0']
- [ais_pdu_to_nmea_0, out, zeromq_pub_msg_sink_0_0, in]
- [ais_pdu_to_nmea_1, out, zeromq_pub_msg_sink_0_0, in]
- [analog_const_source_x_0, '0', qtgui_time_sink_x_0, '1']
- [blocks_complex_to_mag_squared_0, '0', adsb_framer_1, '0']
- [blocks_float_to_complex_0, '0', blocks_throttle_0_0, '0']
- [blocks_float_to_complex_0_0, '0', blocks_throttle_0_1, '0']
- [blocks_throttle_0_0, '0', blocks_complex_to_mag_squared_0, '0']
- [blocks_throttle_0_1, '0', freq_xlating_fir_filter_xxx_0, '0']
- [blocks_throttle_0_1, '0', freq_xlating_fir_filter_xxx_1, '0']
- [blocks_wavfile_source_0, '0', blocks_float_to_complex_0, '1']
- [blocks_wavfile_source_0, '1', blocks_float_to_complex_0, '0']
- [blocks_wavfile_source_0_0, '0', blocks_float_to_complex_0_0, '0']
- [blocks_wavfile_source_0_0, '1', blocks_float_to_complex_0_0, '1']
- [ais_nrzi_0, '0', ais_invert_0, '0']
- [digital_gmsk_demod_0, '0', ais_nrzi_0, '0']
- [ais_nrzi_1, '0', ais_invert_1, '0']
- [digital_gmsk_demod_1, '0', ais_nrzi_1, '0']
- [digital_hdlc_deframer_bp_0, out, ais_pdu_to_nmea_0, print]
- [digital_hdlc_deframer_bp_1, out, ais_pdu_to_nmea_1, print]
- [ais_to_48k_0, '0', digital_gmsk_demod_0, '0']
- [freq_xlating_fir_filter_xxx_0, '0', ais_to_48k_0, '0']
- [ais_to_48k_1, '0', digital_gmsk_demod_1, '0']
- [freq_xlating_fir_filter_xxx_1, '0', ais_to_48k_1, '0']

